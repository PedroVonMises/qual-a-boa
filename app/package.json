  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest",
    "test:sql": "node --import tsx --test \"../supabase/tests/**/*.test.ts\"",
    "seed": "tsx ../supabase/seed/build.ts"
