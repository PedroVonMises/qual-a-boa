{
  "expo": {
    "name": "Qual a boa?",
    "slug": "qual-a-boa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "qualaboa",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#121110",
    "ios": {
      "bundleIdentifier": "br.com.qualaboa.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Usamos sua localização só para ordenar as casas por distância."
      }
    },
    "android": {
      "package": "br.com.qualaboa.app",
      "adaptiveIcon": {
        "backgroundColor": "#3A1220",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#3A1220"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Usamos sua localização só para ordenar as casas por distância.",
          "locationAlwaysAndWhenInUsePermission": "Usamos sua localização só para ordenar as casas por distância.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      "expo-image",
      "expo-localization",
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "extraProguardRules": "# R8 removed the generated Room database used by WorkManager at startup\n-keep class androidx.work.** { *; }\n-keep class * extends androidx.room.RoomDatabase { *; }\n-dontwarn androidx.work.**\n"
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "5beff1f1-6d21-47af-bd8b-95c85c79a348"
      }
    },
    "owner": "pedrovonmisess-team"
  }
}
