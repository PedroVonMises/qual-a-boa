# Copy to .env (never commit .env). Only EXPO_PUBLIC_* values reach the client.
#
# Where each build gets its values (the anon/publishable key is public by design; RLS is the security
# boundary; NEVER put the service_role key in any EXPO_PUBLIC_* variable):
#   local dev    this file (.env)
#   web          Vercel project env vars. Preview: DATA_SOURCE=supabase + URL + key. Production: none (seed)
#                until the catalog is real. APP_ENV=production comes from vercel.json.
#   native       EAS environments (eas env:list <development|preview|production>), selected by the
#                "environment" field of each profile in eas.json. production is pinned to seed.
# seed = built-in Vitória seed data (default, no backend needed); supabase = remote project
EXPO_PUBLIC_DATA_SOURCE=seed
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# feed = static JSON feed (cached, refreshed every 6 h, bundled seed as offline fallback); supabase needs the two vars below
# EXPO_PUBLIC_DATA_SOURCE=feed
# Optional override of the feed location (default: https://qual-a-boa-lime.vercel.app/feed/v1/events.json). https only.
# EXPO_PUBLIC_FEED_URL=
# production hides the demo tools in Perfil (store builds); anything else keeps them
# EXPO_PUBLIC_APP_ENV=production
